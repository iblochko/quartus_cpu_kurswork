--synthesis_resources = reg 2 
SUBDESIGN cmpr_7fj
( 
	aeb	:	output;
	aneb	:	output;
	clken	:	input;
	clock	:	input;
	dataa[4..0]	:	input;
	datab[4..0]	:	input;
) 
VARIABLE 
	aeb_output_dffe0a[0..0] : dffe;
	aneb_output_dffe0a[0..0] : dffe;
	aeb_output_dffe_d_wire0w[0..0]	: WIRE;
	aeb_output_dffe_q_wire0w[0..0]	: WIRE;
	aeb_result_wire[0..0]	: WIRE;
	aneb_output_dffe_d_wire0w[0..0]	: WIRE;
	aneb_output_dffe_q_wire0w[0..0]	: WIRE;
	aneb_result_wire[0..0]	: WIRE;
	data_wire[12..0]	: WIRE;
	eq_wire	: WIRE;
	neq_wire	: WIRE;

BEGIN 
	aeb_output_dffe0a[].clk = clock;
	aeb_output_dffe0a[].d = ( (! aeb_output_dffe_d_wire0w[0..0]));
	aeb_output_dffe0a[].ena = clken;
	aneb_output_dffe0a[].clk = clock;
	aneb_output_dffe0a[].d = aneb_output_dffe_d_wire0w[];
	aneb_output_dffe0a[].ena = clken;
	aeb = eq_wire;
	aeb_output_dffe_d_wire0w[] = ( ((data_wire[3..3] # data_wire[4..4]) # data_wire[5..5]));
	aeb_output_dffe_q_wire0w[] = aeb_output_dffe0a[].q;
	aeb_result_wire[0..0] = aeb_output_dffe_q_wire0w[0..0];
	aneb = neq_wire;
	aneb_output_dffe_d_wire0w[] = ( ((data_wire[0..0] # data_wire[1..1]) # data_wire[2..2]));
	aneb_output_dffe_q_wire0w[] = aneb_output_dffe0a[].q;
	aneb_result_wire[0..0] = aneb_output_dffe_q_wire0w[0..0];
	data_wire[] = ( datab[4..4], dataa[4..4], datab[3..3], dataa[3..3], datab[2..2], dataa[2..2], datab[1..1], dataa[1..1], datab[0..0], dataa[0..0], (data_wire[14..14] $ data_wire[15..15]), ((data_wire[10..10] $ data_wire[11..11]) # (data_wire[12..12] $ data_wire[13..13])), ((data_wire[6..6] $ data_wire[7..7]) # (data_wire[8..8] $ data_wire[9..9])));
	eq_wire = aeb_result_wire[];
	neq_wire = aneb_result_wire[];
	ASSERT (0) 
	REPORT "MGL_INTERNAL_ERROR: Port lpm_compare|data_wire is of width 13 but the range indices are (13, 13) CAUSE : The range indices are illegal, either the higher index is more than the width of the port or the lower index is less than 0."
	SEVERITY ERROR;
	ASSERT (0) 
	REPORT "MGL_INTERNAL_ERROR: Port lpm_compare|data_wire is of width 13 but the range indices are (15, 15) CAUSE : The range indices are illegal, either the higher index is more than the width of the port or the lower index is less than 0."
	SEVERITY ERROR;
	ASSERT (0) 
	REPORT "MGL_INTERNAL_ERROR: Port lpm_compare|data_wire is of width 13 but the range indices are (14, 14) CAUSE : The range indices are illegal, either the higher index is more than the width of the port or the lower index is less than 0."
	SEVERITY ERROR;
END;
--ERROR FILE
